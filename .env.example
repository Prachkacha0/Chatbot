# =============================================================
#  Polaris — Environment Configuration
# =============================================================
# 1. Copy this file to a new file named ".env"  (in the same folder)
# 2. Paste your real API keys below.
# 3. Typhoon key: https://playground.opentyphoon.ai/  ->  API Key
# 4. Gemini key:  https://aistudio.google.com/app/apikey
# 5. Never commit the real .env file to source control.
# -------------------------------------------------------------

# OPTIONAL — Typhoon API key
# Leave blank if you only want to use Gemini.
TYPHOON_API_KEY=

# OPTIONAL — Gemini API key
# Leave blank if you only want to use Typhoon.
GEMINI_API_KEY=

# OPTIONAL — provider defaults
# typhoon = use Typhoon first, fall back to Gemini automatically if Typhoon
#           is down or unavailable (recommended: Gemini's free tier allows
#           only ~20 requests per day per model)
# gemini  = use Gemini first, fall back to Typhoon
# auto    = same as "gemini"
GROUNDED_PROVIDER=typhoon
CONVERSATION_PROVIDER=typhoon

# OPTIONAL — model ids
# Typhoon chat models (verified via GET /v1/models): typhoon-v2.5-30b-a3b-instruct
TYPHOON_MODEL=typhoon-v2.5-30b-a3b-instruct
GEMINI_MODEL=gemini-3.6-flash

# OPTIONAL — live lookup for questions the textbook doesn't cover
# wikipedia = search English Wikipedia (free, no key) / off = model memory only
WEB_SEARCH=wikipedia

# OPTIONAL — seconds to wait for Gemini before falling back to Typhoon
GEMINI_TIMEOUT=12

# OPTIONAL — Typhoon endpoint (OpenAI-compatible; default is fine)
TYPHOON_BASE_URL=https://api.opentyphoon.ai/v1

# OPTIONAL — retrieval tuning
TOP_K=5
MIN_RELEVANCE=0.06

# OPTIONAL — max textbook figures attached to one grounded answer (0 = no images)
MAX_IMAGES_PER_ANSWER=2

# OPTIONAL — hybrid retrieval (keyword TF-IDF + semantic embedding)
# Off by default: MIN_RELEVANCE is calibrated for keyword-only scores, and
# hybrid scores sit on a much higher scale (off-topic questions score ~0.35+),
# so turning this on also requires re-tuning MIN_RELEVANCE. Needs GEMINI_API_KEY
# with enough embedding quota (the free tier cannot embed the full textbook).
EMBEDDING_MODEL=gemini-embedding-001
# 0 = keyword-only (default), 1 = semantic-only
SEMANTIC_WEIGHT=0
